# jobhunter — переменные окружения. Скопируйте в .env и заполните значения.
# Значения секретов в README/логах не печатаются; имена читаются только отсюда.

# --- Telegram (бот отвечает только владельцу из TELEGRAM_CHAT_ID) ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
# chat id владельца; можно несколько через запятую: "123,456"
TELEGRAM_CHAT_ID=

# --- LLM (необязательно: без ключа система работает полностью на правилах) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# дневной бюджет в USD, сверх него ререйтинг и черновики отключаются
LLM_DAILY_BUDGET_USD=0.50

# --- Telethon (этап 3, парсинг TG-каналов; без него источник выключен) ---
# TG_API_ID=
# TG_API_HASH=
# TG_SESSION_PATH=data/jobhunter-telethon

# --- Runtime (всё ниже имеет разумные значения по умолчанию) ---
# TIMEZONE=Europe/Moscow
# DB_PATH=data/jobhunter.db
# BACKUP_DIR=data/backups
# BACKUP_KEEP=7
# LOG_LEVEL=INFO
# LOG_JSON=false
# DIGEST_TIME=09:00
# WEEKLY_REPORT_WEEKDAY=0
# ALERTS_PER_HOUR=3
# HTTP_TIMEOUT=20
# HTTP_MAX_RETRIES=3
# FETCH_CONCURRENCY=4
# DOMAIN_MIN_INTERVAL=1.2
# FETCH_INTERVAL_MINUTES=60
# HEALTHZ_PORT=8080
# FOLLOWUP_DAYS=6
